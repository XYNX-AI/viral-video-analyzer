# Docker Compose interpolation settings. Do not put API keys or cookies here.
NEXT_PUBLIC_API_URL=
# Python and Debian build dependencies use direct package mirrors.
# PLAYWRIGHT_PROXY is also used for the Chromium download during image build.
YTDLP_PROXY=http://host.docker.internal:7891
PLAYWRIGHT_PROXY=http://host.docker.internal:7891
HTTP_PROXY=http://host.docker.internal:7891
HTTPS_PROXY=http://host.docker.internal:7891
